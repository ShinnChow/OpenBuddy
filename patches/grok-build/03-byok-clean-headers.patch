     user_id: Option<&'a str>,
+    /// True when the request targets an xAI first-party endpoint. When false,
+    /// all `x-grok-*` header injection is skipped.
+    first_party: bool,
+}
+
+/// OpenBuddy patch: classify an endpoint as xAI first-party. We match on the
+/// host of the base_url rather than a stored flag so the decision follows the
+/// actual configured endpoint (a user can repoint `api.x.ai` to a mirror, or
+/// point `grok` at a third-party OpenAI-compatible host). Recognized hosts:
+///   - `api.x.ai`            (xAI public API, default for the `grok` provider)
+///   - any `*.grok.com` host (grok Build internal proxy, e.g. cli-chat-proxy)
+/// Anything else — OpenAI, Anthropic, DeepSeek, Qwen, Tencent LKEAP, custom —
+/// is treated as third-party and gets clean, header-stripped requests.
+fn is_first_party_endpoint(base_url: &str) -> bool {
+    // Cheap host extraction: strip scheme, take up to the next '/' or ':'.
+    let after_scheme = base_url
+        .split_once("://")
+        .map(|(_, rest)| rest)
+        .unwrap_or(base_url);
+    let host = after_scheme
+        .split(['/', ':'])
+        .next()
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    host == "api.x.ai" || host.ends_with(".grok.com") || host == "grok.com"
 }
 
