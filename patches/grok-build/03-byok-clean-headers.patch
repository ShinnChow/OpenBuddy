 /// Per-request `x-grok-*` headers. Optional fields are skipped when empty/`None`.
+///
+/// OpenBuddy patch: `first_party` controls whether the `x-grok-*` routing
+/// headers are injected at all. These headers are meaningful only to xAI's
+/// own backends (`api.x.ai` and the grok Build proxy host). Sending them to a
+/// third-party BYOK endpoint (OpenAI, Anthropic, Tencent LKEAP, DeepSeek, ...)
+/// is harmless to tolerant gateways but breaks strict ones that reject unknown
+/// request headers with 400/422. When `first_party` is false, `apply` returns
+/// the builder untouched so no grok-specific headers leak to third parties.
 struct GrokRequestHeaders<'a> {
     conv_id: &'a str,
     req_id: &'a str,
@@ -51,10 +59,40 @@ struct GrokRequestHeaders<'a> {
