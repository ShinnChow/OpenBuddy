+/// Register extra tool configs that should be enabled in every agent's
+/// default toolset. Call at process startup, before the first agent is built.
+/// Not idempotent: calling twice appends twice (the caller guards this, see
+/// `register_team_tools` in OpenBuddy).
+pub fn register_enabled_tool_configs(configs: Vec<ToolConfig>) {
+    extra_enabled_tool_configs().lock().extend(configs);
+}
+/// Clone the registered extra-enabled tool configs. Called by
+/// `AgentBuilder::build` every time it constructs a toolset (once per
+/// session), so the configs are merged into every agent — not just the
+/// first. The registration persists for the process lifetime; call
+/// `register_enabled_tool_configs` once at startup.
+pub fn clone_extra_enabled_tool_configs() -> Vec<ToolConfig> {
+    extra_enabled_tool_configs().lock().clone()
+}
